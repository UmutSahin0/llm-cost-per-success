# Copy to .env and fill in. Never commit .env.
# One OpenRouter key is enough for both benchmarks.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: only for `tools run --provider openai`.
OPENAI_API_KEY=

# Tool benchmark defaults, used when --models is omitted.
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENAI_MODEL=gpt-6-luna

# Optional price fallback (USD per 1M tokens) for models missing from data/models.json.
# INPUT_PRICE_PER_MILLION=0.20
# CACHED_INPUT_PRICE_PER_MILLION=0.02
# OUTPUT_PRICE_PER_MILLION=1.20

# Caps output tokens in the tool benchmark (routing, not generation, is measured).
MAX_OUTPUT_TOKENS=512
